# Which catalogue backs the search box.
#   fixture  - bundled local catalogue, deterministic, no network (default)
#   jsonmock - live https://jsonmock.hackerrank.com/api/movies/search (no key, needs network)
VITE_MOVIES_PROVIDER=fixture

# Optional HTTP endpoint that turns a natural-language phrase such as
# "90s sci-fi about space" into {title, yearFrom, yearTo, genres}.
# Leave empty to use the bundled rule-based parser, which needs no key and no network.
# The endpoint must be server-side: never put a model API key in a browser bundle.
VITE_AI_QUERY_ENDPOINT=

# Set to 1 to mount the Vue DevTools overlay in `npm run dev`.
VITE_DEVTOOLS=
