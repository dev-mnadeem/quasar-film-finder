{
  "name": "film-finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Movie search UI in Vue 3, Quasar and Pinia, with a pluggable catalogue source",
  "scripts": {
    "dev": "vite --port 7211 --strictPort",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview --port 7212 --strictPort",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test": "run-s test:unit test:e2e",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "posters": "node scripts/generate-posters.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@quasar/extras": "^1.18.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@quasar/vite-plugin": "^1.12.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.92.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.92.0",
    "prettier": "3.9.10",
    "sass": "^1.108.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
